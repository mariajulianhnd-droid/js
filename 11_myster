// FIND TWO MOST RELATED INSTANCE OF P. AEQUOR
const relatedInstance = arr => 
{
    // use -1 as placeholder, so that if the highest % is 0% then it will still be updated
    let highestPercentage = -1 ;
    let pair = [];
    
    for (let i = 0 ; i < survivingPAequor.length ; i ++) {
    for (let j = i + 1 ; j < survivingPAequor.length ; j++) { // for j = i+1 so that we don't compare the same instance with itself and also to avoid comparing the same pair twice. For example, if we compare instance 1 with instance 2, we don't need to compare instance 2 with instance 1 again.
    
    // check the DNA similarity between two instances of pAequorFactory using the compareDNA() method. 
    const result = survivingPAequor[i].compareDNA(survivingPAequor[j]);

    // .match() searches the string using a Regular Expression (a text pattern finder).
    // /(\d+)%/ is the regex pattern: 
    // - \d+ means "one or more digits/numbers".
    // - (...) creates a capture group, telling JavaScript: "Remember just the digits inside these parentheses."
    // - % means the digits must be followed immediately by a % sign.
    const match = result.match(/(\d+)%/);
    
    // if the match value exist, take the value at index 1 into numeric value
    // if the match value does not exist, then set percentage to 0 and we use parseInt() to convert the string to a number. then match[1] because there's 2 values in the array, the first value is the entire match, and the second value is the first capture group. We want the first capture group, which is the digits before the % sign. 
    const percentage = match ? parseInt(match[1]) : 0;

    // if the percentage is greater than the highest percentage, then update the highest percentage and store the pair of instances in the pair array.
    if (percentage > highestPercentage) {
        highestPercentage = percentage;
        pair = [survivingPAequor[i],survivingPAequor[j]];
          } // end bracket if condition 

        } // end bracket of inner 'for' loop 
      } // end bracket of outer 'for' loop

    return pair.length > 0 ? pair[0].compareDNA(pair[1]) : '';
};

